#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd -P "$ROOT/.." && pwd)
SOURCE_REPO="${NINFER_SOURCE_REPO:-https://github.com/practicorecoza/ninfer-engine.git}"
SOURCE_REF="${NINFER_SOURCE_REF:-27b24bae4d63633a0f8681ef9b5cc253fd964bf1}"
IMAGE="${NINFER_IMAGE_REPOSITORY:-ghcr.io/practicorecoza/ninfer-sm120a-quant-kv}"
TAG=
PUSH=0

usage() {
  cat <<'EOF'
usage: ./docker/build-image [--ref COMMIT] [--image REPOSITORY] [--tag TAG] [--push]

Builds the shared model-free sm_120a NInfer runtime locally. The source ref must
be a full commit hash from practicorecoza/ninfer-engine. --push publishes the image;
authenticate to GHCR first.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --ref)   [ "$#" -ge 2 ] || { usage >&2; exit 2; }; SOURCE_REF=$2; shift 2 ;;
    --image) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; IMAGE=$2; shift 2 ;;
    --tag)   [ "$#" -ge 2 ] || { usage >&2; exit 2; }; TAG=$2; shift 2 ;;
    --push)  PUSH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ "$SOURCE_REF" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'error: --ref must be a full 40-character commit hash\n' >&2
  exit 2
}

TAG="${TAG:-${SOURCE_REF:0:8}-rk4v4e8-vision8k-froggeric}"
IMAGE_REF="$IMAGE:$TAG"

printf 'building %s\nsource: %s@%s\n' "$IMAGE_REF" "$SOURCE_REPO" "$SOURCE_REF"
docker build --platform linux/amd64 --file "$ROOT/Dockerfile" \
  --build-arg "NINFER_REPO=$SOURCE_REPO" --build-arg "NINFER_REF=$SOURCE_REF" \
  --tag "$IMAGE_REF" "$PROJECT_ROOT"

docker run --rm --entrypoint /bin/sh "$IMAGE_REF" -ec '
  test -x /root/ninfer-5090/build-sm120a/apps/ninfer
  test -x /root/ninfer-5090/build-sm120a/apps/ninfer-serve
  test -x /usr/local/bin/ninfer-entrypoint
  test -x /usr/sbin/sshd
  test -x /opt/hf/bin/hf
  test -f /usr/share/doc/ninfer/BUILDINFO
  test -f /usr/share/doc/ninfer/LICENSE
  test -f /usr/share/doc/ninfer/froggeric-chat-template.jinja
  ! find /etc/ssh -maxdepth 1 -name "ssh_host_*_key" | grep -q .
'

printf 'built and layout-checked: %s\n' "$IMAGE_REF"
if [ "$PUSH" -eq 1 ]; then
  docker push "$IMAGE_REF"
  docker buildx imagetools inspect "$IMAGE_REF"
fi
